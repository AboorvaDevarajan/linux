#!/usr/bin/env bpftrace
/*
 * Black-box HTX/BTT alias detector.
 *
 * Detects when two different premaps point to the same physical postmap
 * block at runtime — the signature of BTT map corruption.
 *
 * Uses actual kernel symbols from nd_btt module (confirmed via kallsyms):
 *   btt_map_write.constprop.0  — map update after COW write
 *   __btt_log_write            — flog entry write (called by btt_flog_write)
 *   btt_submit_bio             — main BTT bio entry point
 *
 * Usage:
 *   sudo bpftrace repro/btt_blackbox_alias.bt
 *   # then run HTX in another terminal
 *
 * Output:
 *   ALIAS lines when dual-ownership is detected
 *   FLOG samples every 1024 flog writes
 *   Summary on Ctrl-C
 */

config = { missing_probes = "warn" }

/* BTT arena can have ~500k LBAs; size maps accordingly */
let @fwd = hash(524288);
let @rev = hash(524288);

BEGIN
{
	printf("BTT blackbox alias detector started\n");
	printf("Probing: btt_map_write.constprop.0, __btt_log_write [nd_btt]\n");
}

/*
 * btt_map_write(arena, lba, mapping, z_flag, e_flag, rwb_flags)
 * Compiler emits as btt_map_write.constprop.0 in nd_btt module.
 *
 * arg1 = lba (premap)
 * arg2 = mapping (postmap, may have flag bits in upper 2 bits)
 */
kprobe:btt_map_write.constprop.0
{
	$premap = (uint32)arg1;
	$new    = ((uint32)arg2) & 0x3fffffff;
	$p1     = $premap + 1;

	$owner_p1 = @rev[$new];
	if ($owner_p1 != 0 && $owner_p1 != $p1) {
		$owner = $owner_p1 - 1;
		@alias_count++;
		printf("ALIAS cpu=%d comm=%s premap=0x%x new_post=0x%x owner_premap=0x%x\n",
		       cpu, comm, $premap, $new, $owner);
	}

	$old = @fwd[$premap];
	if ($old != 0) {
		if (@rev[$old] == $p1) {
			delete(@rev[$old]);
		}
	}

	@fwd[$premap] = $new;
	@rev[$new] = $p1;
	@mapwrite_count++;
}

/*
 * __btt_log_write(arena, lane, sub, ent, flags)
 * struct log_entry { __le32 lba, old_map, new_map, seq; }
 *
 * arg1 = lane
 * arg3 = pointer to struct log_entry
 */
kprobe:__btt_log_write
{
	$lane = (uint32)arg1;

	@flog_count++;

	if ((@flog_count & 1023) == 0) {
		printf("FLOG sample cpu=%d comm=%s lane=%u count=%lld\n",
		       cpu, comm, $lane, @flog_count);
	}
}

END
{
	printf("\n=== btt_blackbox_alias summary ===\n");
	printf("map_write events: %lld\n", @mapwrite_count);
	printf("flog events:      %lld\n", @flog_count);
	printf("ALIAS detections: %lld\n", @alias_count);

	clear(@fwd);
	clear(@rev);
}
