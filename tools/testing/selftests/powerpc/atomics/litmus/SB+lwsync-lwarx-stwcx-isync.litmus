PPC SB+lwsync-lwarx-stwcx-isync

(*
 * Result: Sometimes
 *
 * Kernel mapping used as an SB fence: lwsync ; lwarx/stwcx. ; bne ;
 * isync, with independent reservation lines. bne retry matches the
 * in-kernel LL/SC loop (control dependency into isync on the
 * success fall-through).
 *
 * herd's published Power model (ppc.cat) reports Sometimes: only
 * sync is a strong fence. lwsync is light and does not order
 * store-load. isync is ppo/ctrlisync, not A-cumulative. Successful
 * stwcx. is an ordinary store plus rmw atomicity. ppc.cat does not
 * encode Piggin's extra claim that a completed stcx. has already
 * performed in the reservation protocol.
 *
 * This is a model gap, not a herd proof that the ISA mapping is
 * wrong. Controls: SB+lwsyncs Sometimes, SB+syncs Never.
 *)

{
0:r1=x; 0:r2=y; 0:r3=1; 0:r5=u;
1:r1=y; 1:r2=x; 1:r3=1; 1:r5=v;
}

 P0                    | P1                   ;
 stw r3,0(r1)          | stw r3,0(r1)         ;
 lwsync                | lwsync               ;
L0: lwarx r6,r0,r5     |L1: lwarx r6,r0,r5    ;
 addi r6,r6,1          | addi r6,r6,1         ;
 stwcx. r6,r0,r5       | stwcx. r6,r0,r5      ;
 bne L0                | bne L1               ;
 isync                 | isync                ;
 lwz r4,0(r2)          | lwz r4,0(r2)         ;

filter ([u]=1 /\ [v]=1)
exists (0:r4=0 /\ 1:r4=0)
