PPC SB+lwsyncs

(*
 * Result: Sometimes
 *
 * Control: lwsync does not order store-load, so store buffering is
 * allowed. The RFC sequence must do better than this.
 *)

{
0:r1=x; 0:r2=y; 0:r3=1;
1:r1=y; 1:r2=x; 1:r3=1;
}

 P0           | P1           ;
 stw r3,0(r1) | stw r3,0(r1) ;
 lwsync       | lwsync       ;
 lwz r4,0(r2) | lwz r4,0(r2) ;

exists (0:r4=0 /\ 1:r4=0)
